#!/usr/bin/env bash
# Password Manager CLI launcher
# Cross-platform wrapper that finds Python and runs the CLI module.
#
# Usage:
#   ./scripts/passwordmanager [list|create|retrieve|delete] [secret|group] [name|id]
#
# Configuration:
#   API key from $SECRETSMANAGER_API_KEY or ~/.secretsmanager/apikey
#   Base URL from $SECRETSMANAGER_BASE_URL or http://localhost:8000

set -euo pipefail

# Determine the directory where this script lives
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Find python3
PYTHON=""
for cmd in python3 python; do
    if command -v "$cmd" &>/dev/null; then
        PYTHON="$cmd"
        break
    fi
done

if [[ -z "$PYTHON" ]]; then
    echo "Error: Python 3 is required but not installed." >&2
    exit 1
fi

# Check if we can use the module directly (CLI is installed or in path)
if [[ -d "$PROJECT_DIR/backend/cli" ]]; then
    PYTHONPATH="$PROJECT_DIR/backend:$PYTHONPATH" "$PYTHON" -m cli.passwordmanager "$@"
else
    # Fallback: look for cli in PYTHONPATH
    "$PYTHON" -m cli.passwordmanager "$@"
fi
